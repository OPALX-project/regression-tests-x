// Isolated TDC voltage scan: multiplier 1000000.
// Isolated TDC comparison, not the full EEX lattice.
// TDC moved from ELEMEDGE=3.335485 to 0; track starts at t=0.
// Original map bytes, voltage, frequency and LAG are retained.
// Identical 1000-particle records from the legacy Gaussian distribution export.

OPTION, INFO=TRUE;
OPTION, PSDUMPFREQ=0;
OPTION, STATDUMPFREQ=10;
OPTION, ENABLEHDF5=TRUE;
OPTION, ENABLEVTK=FALSE;
OPTION, ASCIIDUMP=FALSE;
OPTION, AUTOPHASE=0;

TDC: RFCAVITY, L=0.47903, VOLT=-2.2497435304821716, ELEMEDGE=0,
     TYPE=STANDING, FMAPFN="TDC.txt", FREQ=1300,
     LAG=1.5514735997026097+PI/2;

MYLINE: LINE=(TDC);

DIST: DISTRIBUTION, TYPE=FROMFILE, NPARTDIST=1000, FNAME="inputdistr.dat";

ES: EMISSIONSOURCE, DISTRIBUTION=DIST;

SOURCES1: EMISSIONSOURCELIST=(ES);

FS: FIELDSOLVER, TYPE=NONE, NX=32, NY=32, NZ=32, 
    BCFFTX=OPEN, BCFFTY=OPEN, BCFFTZ=OPEN;

BEAM1: BEAM, PARTICLE=ELECTRON, NALLOC=1000, BCHARGE=9.6369e-9, 
       CHARGE=-1, SOURCES=SOURCES1;

TRACK, LINE=MYLINE, BEAM=BEAM1, MAXSTEPS=2000, DT=1e-12, ZSTOP=0.500;

RUN, METHOD=PARALLEL, FIELDSOLVER=FS;

ENDTRACK;
STOP;

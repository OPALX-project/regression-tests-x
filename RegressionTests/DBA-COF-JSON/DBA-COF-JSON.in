// 2.5 MeV proton DBA (lattice of DBA-COF-Track-1): COF only, no tracking, result written to orbit.json.
// DOP853 integrator, as in COF results of FFA lattices. The Newton solve starts 1 mm and 1e-4 p/(mc)
// off the closed orbit in both planes, so the stored orbit is a solved result, not the initial guess.
// The .rt checks the closed orbit, the full tunes, the orbit length and the energy drift in orbit.json.
OPTION, ECHO=FALSE, ASCIIDUMP=FALSE, SEED=20260910,
        REPARTFREQ=0, PSDUMPFREQ=0, STATDUMPFREQ=1000000000, STEPINFOFQ=1000000000;
OPTION, ENABLELINEARTRANSFERMAPS=FALSE;
TITLE, STRING="DBA-COF-JSON: COF result JSON of a proton DBA ring";

REAL P0=0.068539116182958951;

C1_B1: SBEND, L=1.0471975511965976, ANGLE=0.52359877559829882, HGAP=0, FINT=0, X=0, Y=0, Z=0, THETA=-0, PHI=0, PSI=0;
C1_D1: DRIFT, L=1, APERTURE="RECTANGLE(1.0,0.2)", X=-0.26794919243112258, Y=0, Z=0.99999999999999989, THETA=-0.52359877559829882, PHI=0, PSI=0;
C1_Q: QUADRUPOLE, L=0.20000000000000001, APERTURE="RECTANGLE(1.0,0.2)", K1=-2.8399999999999999, X=-0.76794919243112258, Y=0, Z=1.8660254037844386, THETA=-0.52359877559829882, PHI=0, PSI=0;

C4_B1: SBEND, L=1.0471975511965976, ANGLE=0.52359877559829882, HGAP=0, FINT=0, X=-8.4000000000000004, Y=0, Z=1.9984014443252818e-15, THETA=-3.1415926535897927, PHI=0, PSI=0;

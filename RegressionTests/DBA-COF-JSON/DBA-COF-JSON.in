C6_D1: DRIFT, L=1, APERTURE="RECTANGLE(1.0,0.2)", X=-1.3679491924311269, Y=0, Z=-2.9052558883257649, THETA=-5.759586531581288, PHI=0, PSI=0;
C6_Q: QUADRUPOLE, L=0.20000000000000001, APERTURE="RECTANGLE(1.0,0.2)", K1=-2.8399999999999999, X=-0.86794919243112723, Y=0, Z=-2.039230484541326, THETA=-5.759586531581288, PHI=0, PSI=0;
C6_D2: DRIFT, L=1, APERTURE="RECTANGLE(1.0,0.2)", X=-0.76794919243112725, Y=0, Z=-1.8660254037844384, THETA=-5.759586531581288, PHI=0, PSI=0;
C6_B2: SBEND, L=1.0471975511965976, ANGLE=0.52359877559829882, HGAP=0, FINT=0, X=-0.26794919243112758, Y=0, Z=-0.99999999999999956, THETA=-5.759586531581288, PHI=0, PSI=0;

LATTICE: RING = (C1_D1, C1_Q, C1_D2, C1_B2, C2_B1, C2_D1, C2_Q, C2_D2, C2_B2, C3_B1, C3_D1, C3_Q, C3_D2, C3_B2, C4_B1, C4_D1, C4_Q, C4_D2, C4_B2, C5_B1, C5_D1, C5_Q, C5_D2, C5_B2, C6_B1, C6_D1, C6_Q, C6_D2, C6_B2, C1_B1);

// BEAM needs a source; COF only uses its reference momentum.
DIST: DISTRIBUTION, TYPE=GAUSS, NPARTDIST=1,
    SIGMAX=1e-12, SIGMAY=1e-12, SIGMAZ=1e-12,
    CUTOFFX=3, CUTOFFY=3, CUTOFFLONG=3, SIGMAPX=0, SIGMAPY=0, SIGMAPZ=0;
SOURCE: EMISSIONSOURCE, DISTRIBUTION=DIST;
SOURCES: EMISSIONSOURCELIST=(SOURCE);
BEAM1: BEAM, PARTICLE=PROTON, CHARGE=1, NALLOC=1, SOURCES=SOURCES,
    BCHARGE=1.6021766339999999e-19, PC=P0;
ORBIT: COF, LINE=LATTICE, BEAM=BEAM1,
    SECTION={-0.51794919243112258,0,1.4330127018922192,-0.52359877559829882,0,0},
    DT=6.25e-11, MAXSTEPS=2000000, MAXPATH=35, TIMEINTEGRATOR="DOP853",
    X=1e-3, PX=1e-4, Y=1e-3, PY=1e-4,
    FDSTEP={3e-5,2.1914469282796546e-6,3e-5,2.1914469282796546e-6},
    SCALES={1,0.07304823084391622,1,0.07304823084391622},
    OUTPUT="orbit.json";
QUIT;

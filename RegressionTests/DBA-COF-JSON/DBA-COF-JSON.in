C2_B1: SBEND, L=1.0471975511965976, ANGLE=0.52359877559829882, HGAP=0, FINT=0, X=-2.0999999999999996, Y=0, Z=3.6373066958946425, THETA=-1.0471975511965976, PHI=0, PSI=0;

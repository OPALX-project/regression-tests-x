C5_B1: SBEND, L=1.0471975511965976, ANGLE=0.52359877559829882, HGAP=0, FINT=0, X=-6.3000000000000043, Y=0, Z=-3.6373066958946412, THETA=-4.1887902047863905, PHI=0, PSI=0;
C5_D1: DRIFT, L=1, APERTURE="RECTANGLE(1.0,0.2)", X=-5.3000000000000043, Y=0, Z=-3.9052558883257644, THETA=-4.7123889803846897, PHI=0, PSI=0;
C5_Q: QUADRUPOLE, L=0.20000000000000001, APERTURE="RECTANGLE(1.0,0.2)", K1=-2.8399999999999999, X=-4.3000000000000043, Y=0, Z=-3.9052558883257644, THETA=-4.7123889803846897, PHI=0, PSI=0;
C5_D2: DRIFT, L=1, APERTURE="RECTANGLE(1.0,0.2)", X=-4.1000000000000041, Y=0, Z=-3.9052558883257644, THETA=-4.7123889803846897, PHI=0, PSI=0;
C5_B2: SBEND, L=1.0471975511965976, ANGLE=0.52359877559829882, HGAP=0, FINT=0, X=-3.1000000000000041, Y=0, Z=-3.9052558883257644, THETA=-4.7123889803846897, PHI=0, PSI=0;

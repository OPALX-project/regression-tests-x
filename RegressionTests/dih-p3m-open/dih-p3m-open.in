/*  
	OPALX
    DIH test case with reduced accuracy. 
*/

OPTION, PSDUMPFREQ = 0; // deactivate h5 output
OPTION, STATDUMPFREQ = 1;
OPTION, BOUNDPDESTROY = 100;
OPTION, AUTOPHASE = 4;
OPTION, VERSION = 10900;
OPTION, SEED = 42;
OPTION, REPARTFREQ = 10000;
OPTION, STEPINFOFQ = 100;

TITLE, STRING = "Disorder-induced heating with open P3M";

REAL N = 16;
REAL NP = 15606; // 156055
REAL BEAM_RADIUS = 1.774e-3;
REAL H = 2.1*BEAM_RADIUS/(N - 1);
REAL P0 = 2.0e-3*EMASS;
// Each macro particle represents 10^6 electrons, matching P3MHeating's force scale.
REAL Q = 2.50028e-8;

// Make it big enough such that the bunch is always inside the element
FOCUS: CONSTANTFOCUSING, L = 1.0, ELEMEDGE = -0.5,
    RADIUS = BEAM_RADIUS, STRENGTH = 1.5;
LINE1: LINE = (FOCUS);

FS1: FIELDSOLVER, TYPE = P3M,
    NX = N, NY = N, NZ = N,
    PARFFTX = TRUE, PARFFTY = TRUE, PARFFTZ = TRUE,
    BCFFTX = OPEN, BCFFTY = OPEN, BCFFTZ = OPEN,
    BBOXINCR = 5, RCUT = H;

//DIST1: DISTRIBUTION, TYPE = UNIFORM,
//    SIGMAX = BEAM_RADIUS, SIGMAY = BEAM_RADIUS, SIGMAZ = BEAM_RADIUS,
//    NPARTDIST = NP;
DIST1: DISTRIBUTION, TYPE=FROMFILE,
    FNAME="dih-p3m-open-initial.txt",
    NPARTDIST=NP;
SOURCE1: EMISSIONSOURCE, DISTRIBUTION = DIST1;
SOURCES: EMISSIONSOURCELIST = (SOURCE1);

BEAM1: BEAM, PARTICLE = ELECTRON, NALLOC = NP,
    BCHARGE = Q, SOURCES = SOURCES, CHARGE = -1;

TRACK, LINE = LINE1, BEAM = BEAM1, MAXSTEPS = 250,
    DT = {2.15623e-13 * 4}, ZSTOP = 1.0e-2;
RUN, METHOD = "PARALLEL", FIELDSOLVER = FS1;
ENDTRACK;
QUIT;

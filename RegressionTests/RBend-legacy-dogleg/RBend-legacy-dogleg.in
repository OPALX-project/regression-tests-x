// First AWA EEX dogleg, adapted from awaDrive_EEX.in.
// Fixed 1000-particle distribution from the validated AWA comparison.
// Profile-map lengths are in cm; element lengths and positions are in m.
// Ends after the second dipole fringe, before the original TDC entrance.

OPTION, INFO=TRUE;
OPTION, PSDUMPFREQ=0;
OPTION, STATDUMPFREQ=10;
OPTION, ENABLEHDF5=TRUE;
OPTION, ENABLEVTK=FALSE;
OPTION, ASCIIDUMP=FALSE;
OPTION, AUTOPHASE=0;

REAL DIP_ORIGIN = 0.152314;
REAL DIP1_POS = 0.226 + 0.55 - DIP_ORIGIN;
REAL DIP2_POS = 0.226 + 0.55 + 1.808 - DIP_ORIGIN;
REAL DIP_E = 42.411;
REAL DIP_LEN = 0.3;

EEXDIP1: RBEND, L=DIP_LEN, ANGLE=-20*PI/180,
         ELEMEDGE=DIP1_POS, E1=0, DESIGNENERGY=DIP_E, GAP=0.05,
         FMAPFN="EEXDIP30cm.opal";

EEXDIP2: RBEND, L=DIP_LEN, ANGLE=20*PI/180,
         ELEMEDGE=DIP2_POS, E1=20*PI/180, DESIGNENERGY=DIP_E, GAP=0.05,
         FMAPFN="EEXDIP30cm.opal";

MYLINE: LINE=(EEXDIP1,EEXDIP2);

DIST: DISTRIBUTION, TYPE=FROMFILE, NPARTDIST=1000, FNAME="inputdistr.dat";
ES: EMISSIONSOURCE, DISTRIBUTION=DIST;
SOURCES1: EMISSIONSOURCELIST=(ES);

FS: FIELDSOLVER, TYPE=NONE, NX=8, NY=8, NZ=8;
BEAM1: BEAM, PARTICLE=ELECTRON, NALLOC=1000, BCHARGE=9.6369e-9,
       CHARGE=-1, SOURCES=SOURCES1;

TRACK, LINE=MYLINE, BEAM=BEAM1, MAXSTEPS=2500, DT=5e-12, ZSTOP=3.100;
RUN, METHOD=PARALLEL, FIELDSOLVER=FS;
ENDTRACK;
STOP;

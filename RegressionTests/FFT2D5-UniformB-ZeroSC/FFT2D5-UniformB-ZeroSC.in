// Uniform Bz thin-ellipsoid benchmark; axes rotated to OPALX x-z / By.
// Zero self-field uses TYPE=NONE and nominal charge to retain finite macro q/m.
OPTION, VERSION=10900;
OPTION, PSDUMPFREQ=128;
OPTION, STATDUMPFREQ=1;
OPTION, EBDUMP=TRUE;
OPTION, MINBINEMITTED=0;
REAL P0=0.009382720894282574;
DIST1: DISTRIBUTION, TYPE=FROMFILE, NPARTDIST=98304, FNAME="ellipsoid.dist";
E1: EMISSIONSOURCE, DISTRIBUTION=DIST1, R0X=0,R0Y=0,R0Z=0,P0X=0,P0Y=0,P0Z=0,T0=0, ZEROFACE_R0Z=FALSE,SHIFTED_GREENS_FUNCTION=FALSE,ZEROFACEPLANEDUMP=0,ZEROFACE_MAXSTEPS=0,EMISSIONMODEL=NONE,EKIN=0;
ELIST1: EMISSIONSOURCELIST=(E1);
FS: FIELDSOLVER,TYPE=NONE,NX=8,NY=8,NZ=8,PARFFTX=FALSE,PARFFTY=FALSE,PARFFTZ=FALSE;
B1: BEAM,PARTICLE=PROTON,NALLOC=98304,BCHARGE=1e-13,SOURCES="ELIST1";
UB: FIELDMAP,FMAPFN="uniform-by.g4blmap",BSCALE=1,ESCALE=0,X=0,Y=0,Z=0,THETA=0,PHI=0,PSI=0;
L1: LINE=(UB);
TRACK,BEAM=B1,LINE=L1,MAXSTEPS=128,ZSTOP={6},DT={8.1868946169987571e-09};
RUN,FIELDSOLVER=FS,METHOD="PARALLEL",TURNS=1;
ENDTRACK;

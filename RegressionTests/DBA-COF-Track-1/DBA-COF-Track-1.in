// 2.5 MeV proton DBA: fresh host Boris COF, then device Boris tracking of one central particle.
// Start at the field-free C1_D1 midpoint without splitting or moving any element.
// The generated distribution is orbit-local; INITIALORBIT supplies the solved lab pose.
// No space charge; one directed reference turn. Final statistics only, no HDF5 dumps.
OPTION, VERSION=10900, ECHO=FALSE, ASCIIDUMP=FALSE, SEED=20260910,
        REPARTFREQ=0, PSDUMPFREQ=0, STATDUMPFREQ=1000000000, STEPINFOFQ=1000000000;
OPTION, ENABLELINEARTRANSFERMAPS=FALSE;
TITLE, STRING="DBA-COF-Track-1: named COF to one-turn device TRACK";

REAL P0=0.068539116182958951;

C1_B1: SBEND, L=1.0471975511965976, ANGLE=0.52359877559829882, HGAP=0, FINT=0, X=0, Y=0, Z=0, THETA=-0, PHI=0, PSI=0;

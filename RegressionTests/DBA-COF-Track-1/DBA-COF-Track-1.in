LATTICE: RING = (C1_D1, C1_Q, C1_D2, C1_B2, C2_B1, C2_D1, C2_Q, C2_D2, C2_B2, C3_B1, C3_D1, C3_Q, C3_D2, C3_B2, C4_B1, C4_D1, C4_Q, C4_D2, C4_B2, C5_B1, C5_D1, C5_Q, C5_D2, C5_B2, C6_B1, C6_D1, C6_Q, C6_D2, C6_B2, C1_B1);

// Positive 1 pm sampling widths avoid a singular Gaussian; mean subtraction centres the sole particle exactly.
DIST: DISTRIBUTION, TYPE=GAUSS, NPARTDIST=1,
    SIGMAX=1e-12, SIGMAY=1e-12, SIGMAZ=1e-12,
    CUTOFFX=3, CUTOFFY=3, CUTOFFLONG=3, SIGMAPX=0, SIGMAPY=0, SIGMAPZ=0;
SOURCE: EMISSIONSOURCE, DISTRIBUTION=DIST;
SOURCES: EMISSIONSOURCELIST=(SOURCE);
FS: FIELDSOLVER, TYPE=NONE, NX=16, NY=16, NZ=16,
    PARFFTX=TRUE, PARFFTY=TRUE, PARFFTZ=TRUE, BCFFTX=OPEN, BCFFTY=OPEN, BCFFTZ=OPEN;
BEAM1: BEAM, PARTICLE=PROTON, CHARGE=1, NALLOC=1, SOURCES=SOURCES,
    BCHARGE=1.6021766339999999e-19, PC=P0;
ic: COF, LINE=LATTICE, BEAM=BEAM1,
    SECTION={-0.51794919243112258,0,1.4330127018922192,-0.52359877559829882,0,0},
    DT=6.25e-11, MAXSTEPS=2000000, MAXPATH=35, TIMEINTEGRATOR="BORIS",
    X=0, PX=0, Y=0, PY=0,
    FDSTEP={3e-5,2.1914469282796546e-6,3e-5,2.1914469282796546e-6},
    SCALES={1,0.07304823084391622,1,0.07304823084391622};
TRACK, LINE=LATTICE, BEAM=BEAM1, DT=6.25e-11, MAXSTEPS=200000, INITIALORBIT=ic;
RUN, METHOD="PARALLEL", FIELDSOLVER=FS, TURNS=1;
ENDTRACK;
QUIT;

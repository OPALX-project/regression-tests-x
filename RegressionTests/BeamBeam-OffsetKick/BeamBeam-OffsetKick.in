// Deterministic short rigid-source regression; no HDF5 or generated input.
OPTION, ENABLEHDF5=FALSE;
OPTION, PSDUMPFREQ=0;
OPTION, STATDUMPFREQ=1;
OPTION, STEPINFOFQ=100;
OPTION, BOUNDPDESTROY=1e9;
OPTION, VERSION=10900;
OPTION, IDEALIZED=TRUE;
TITLE, STRING="BeamBeam-OffsetKick: source-only deposition and passive e-/e+ witnesses";

REAL dt_track=1e-12;
REAL ip_s=0.008;
IP1: BEAMBEAM, L=0.016, ELEMEDGE=0, BBRIGID=TRUE,
     COPY_TIME=1e-30, WITNESS_CONTAINERS="1,2",
     APERTURE="RECTANGLE(0.04,0.04)", DELETEONTRANSVERSEEXIT=FALSE;
L1: LINE=(IP1);
BINS1: BINNING, MAXBINS=1, DESIREDWIDTH=0.1, BINNINGALPHA=1,
       BINNINGBETA=1, PARAMETER="VELOCITYZ", ADAPTIVEBINNING=FALSE,
       DUMPBINSFILE="NONE", TABLEPRINTFREQ=0;
FS1: FIELDSOLVER, TYPE=OPEN, BINS="BINS1", NX=32, NY=32, NZ=64,
     PARFFTX=TRUE, PARFFTY=TRUE, PARFFTZ=TRUE,
     BCFFTX=OPEN, BCFFTY=OPEN, BCFFTZ=OPEN, BBOXINCR=1, GREENSF=INTEGRATED;
DP: DISTRIBUTION, TYPE=FROMFILE, FNAME="primary.fromfile", NPARTDIST=512;
DWE: DISTRIBUTION, TYPE=FROMFILE,
    FNAME="witness.fromfile", NPARTDIST=4;
DWX: DISTRIBUTION, TYPE=FROMFILE,
    FNAME="witness.fromfile", NPARTDIST=4;
SP: EMISSIONSOURCE, DISTRIBUTION=DP, R0Z=ip_s-1.5*sqrt(3)/2*CLIGHT*dt_track;
SE: EMISSIONSOURCE, DISTRIBUTION=DWE, R0Z=ip_s;
SX: EMISSIONSOURCE, DISTRIBUTION=DWX, R0Z=ip_s;
LP: EMISSIONSOURCELIST=(SP);
LE: EMISSIONSOURCELIST=(SE);
LX: EMISSIONSOURCELIST=(SX);
BP: BEAM, PARTICLE=ELECTRON, NALLOC=512, BCHARGE=1e-12, SOURCES=LP;
BE: BEAM, PARTICLE=ELECTRON, NALLOC=4, BCHARGE=4*1.602176634e-19,
    SOURCES=LE, ORBITTHREADER=FALSE;
BX: BEAM, PARTICLE=POSITRON, NALLOC=4, BCHARGE=4*1.602176634e-19,
    SOURCES=LX, ORBITTHREADER=FALSE;
TRACK, LINE=L1, BEAMS={BP,BE,BX}, MAXSTEPS=4,
       ZSTART=0, ZSTOP=0.016, DT=dt_track;
RUN, METHOD="PARALLEL", FIELDSOLVER=FS1;
ENDTRACK;
QUIT;
